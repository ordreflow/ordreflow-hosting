DB_PORT=5432
DB_NAME=ordreflow
DB_USERNAME=ordreflow
DB_PASSWORD=change-this-local-password

API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# First admin login, created at startup if it does not exist. Leave empty to skip.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123.
ADMIN_NAME=Administrator

# JWT login tokens. JWT_SECRET is required and must be at least 32 bytes,
# e.g. generated with: openssl rand -base64 48
JWT_SECRET= generate key
JWT_ISSUER=ordreflow-api
JWT_AUDIENCE=ordreflow-frontend
JWT_EXPIRES_MINUTES=60

JWT_SECRET:     "${JWT_SECRET:?JWT_SECRET is required}"
JWT_ISSUER:     "${JWT_ISSUER:?JWT_ISSUER is required}"
JWT_AUDIENCE:   "${JWT_AUDIENCE:?JWT_AUDIENCE is required}"
JWT_EXPIRES_MINUTES:    "${JWT_EXPIRES_MINUTES:?JWT_EXPIRES_MINUTES is required}"