DB_PORT=5432
DB_NAME=ordreflow
DB_USERNAME=ordreflow
DB_PASSWORD=change-this-local-password

API_PORT=8080
FRONTEND_PORT=8081
ASPNETCORE_ENVIRONMENT=Development

# First admin login, created at startup if it does not exist. Leave empty to skip.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123.
ADMIN_NAME=Administrator

# JWT login tokens. JWT_SECRET is required and must be at least 32 bytes,
# replace the placeholder with the output of: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ISSUER=ordreflow-api
JWT_AUDIENCE=ordreflow-frontend
JWT_EXPIRES_MINUTES=60
